{
  "rules": {
    ".read": false,
    ".write": false,
    "roleta_cotas": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      "$dia": {
        "itens": {
          ".read": "auth != null"
        },
        "ativo": {
          ".read": "auth != null"
        },
        "ordem": {
          ".read": "auth != null"
        },
        "entregues": {
          ".read": "auth != null",
          "$key": {
            ".write": "auth != null && root.child('roleta_participantes').child(auth.uid).child('phoneHash').exists() && !root.child('roleta_cotas').child($dia).child('ganhadores').child(root.child('roleta_participantes').child(auth.uid).child('phoneHash').val()).exists() && newData.parent().parent().child('ganhadores').child(root.child('roleta_participantes').child(auth.uid).child('phoneHash').val()).child('uid').val() == auth.uid && newData.parent().parent().child('ganhadores').child(root.child('roleta_participantes').child(auth.uid).child('phoneHash').val()).child('premio').val() == $key",
            ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1 && newData.val() <= root.child('roleta_cotas').child($dia).child('itens').child($key).val() && root.child('roleta_cotas').child($dia).child('ativo').val() != false"
          }
        },
        "ganhadores": {
          "$h": {
            ".read": "auth != null",
            ".write": "auth != null && !data.exists() && $h == root.child('roleta_participantes').child(auth.uid).child('phoneHash').val()",
            ".validate": "newData.child('uid').val() == auth.uid && newData.child('premio').isString() && newData.child('premioId').isString() && newData.parent().parent().child('entregues').child(newData.child('premio').val()).val() == (root.child('roleta_cotas').child($dia).child('entregues').child(newData.child('premio').val()).exists() ? root.child('roleta_cotas').child($dia).child('entregues').child(newData.child('premio').val()).val() : 0) + 1"
          }
        }
      }
    },
    "roleta_config": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'"
    },
    "roleta_stats": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      "$dia": {
        "giros": {
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "roleta_giros": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      ".indexOn": [
        "dia"
      ],
      "$k": {
        ".read": "auth != null && $k.beginsWith(auth.uid + '-')",
        ".write": "auth != null && $k.beginsWith(auth.uid + '-')",
        "giros": {
          ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1 && newData.val() <= 10"
        }
      }
    },
    "roleta_participantes": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['phoneHash', 'participationNumber', 'pid', 'chave']) && newData.child('pid').val().beginsWith(auth.uid + '-') && newData.child('chave').val().beginsWith(auth.uid + '-') && newData.parent().parent().child('roleta_telefones').child(newData.child('phoneHash').val()).child('uid').val() == auth.uid && newData.parent().parent().child('roleta_telefones').child(newData.child('phoneHash').val()).child('participationNumber').val() == newData.child('participationNumber').val()"
      }
    },
    "roleta_telefones": {
      "$h": {
        ".read": "auth != null",
        "uid": {
          ".write": "auth != null && (!data.parent().child('ultimaMs').exists() || now - data.parent().child('ultimaMs').val() > 120000)",
          ".validate": "newData.val() == auth.uid"
        },
        "participationNumber": {
          ".write": "auth != null && (!data.parent().child('ultimaMs').exists() || now - data.parent().child('ultimaMs').val() > 120000)",
          ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
        },
        "ultimaMs": {
          ".write": "auth != null && (!data.exists() || now - data.val() > 120000)",
          ".validate": "newData.val() == now"
        },
        "ganhos": {
          "$k": {
            ".write": "auth != null && $h == root.child('roleta_participantes').child(auth.uid).child('phoneHash').val()",
            ".validate": "newData.val() == true"
          }
        }
      }
    },
    "roleta_meus_premios": {
      "$h": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && !data.exists() && $h == root.child('roleta_participantes').child(auth.uid).child('phoneHash').val()",
          ".validate": "newData.isString() && newData.parent().parent().parent().child('roleta_cotas').child(newData.val()).child('ganhadores').child($h).child('premioId').val() == $id"
        }
      }
    },
    "entradas": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      ".indexOn": [
        "enteredAt"
      ],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() == auth.uid",
        ".validate": "newData.child('enteredAt').val() == now"
      }
    },
    "premios": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      ".indexOn": [
        "createdAtMs",
        "phone"
      ],
      "$premioId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('uid').val() == auth.uid && newData.child('origem').val() == 'cota' && !root.child('roleta_cotas').child(newData.child('dia').val()).child('ganhadores').child(root.child('roleta_participantes').child(auth.uid).child('phoneHash').val()).exists() && newData.parent().parent().child('roleta_cotas').child(newData.child('dia').val()).child('ganhadores').child(root.child('roleta_participantes').child(auth.uid).child('phoneHash').val()).child('premioId').val() == $premioId && newData.parent().parent().child('roleta_cotas').child(newData.child('dia').val()).child('ganhadores').child(root.child('roleta_participantes').child(auth.uid).child('phoneHash').val()).child('premio').val() == newData.child('quotaKey').val() && ((newData.child('quotaKey').val() == 'brinde' && newData.child('type').val() == 'gift') || (newData.child('quotaKey').val() == 'adesao' && newData.child('type').val() == 'adesao') || (newData.child('type').val() == 'discount' && ((newData.child('quotaKey').val() == '50' && newData.child('desconto').val() == 50) || (newData.child('quotaKey').val() == '30' && newData.child('desconto').val() == 30) || (newData.child('quotaKey').val() == '20' && newData.child('desconto').val() == 20) || (newData.child('quotaKey').val() == '15' && newData.child('desconto').val() == 15) || (newData.child('quotaKey').val() == '10' && newData.child('desconto').val() == 10))))",
        "utilizado": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
          ".validate": "newData.isBoolean()"
        },
        "utilizadoEmMs": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'"
        },
        "utilizadoPor": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'"
        },
        "cancelado": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
          ".validate": "newData.isBoolean()"
        },
        "canceladoEmMs": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'"
        },
        "canceladoPor": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'"
        }
      }
    },
    "indicacoes": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      ".indexOn": [
        "criadoEmMs",
        "status"
      ],
      "$cupom": {
        ".write": "auth != null && !data.exists() && $cupom.matches(/^IND-[A-Z2-9]{6}$/) && newData.child('cupom').val() == $cupom && newData.child('uid').val() == auth.uid && newData.child('status').val() == 'cupom_gerado' && newData.child('criadoEmMs').val() == now && newData.child('consentimento').val() == true && !root.child('indique_cpfs').child(newData.child('cpfHash').val()).exists() && newData.parent().parent().child('indique_cpfs').child(newData.child('cpfHash').val()).child('cupom').val() == $cupom",
        ".validate": "newData.hasChildren(['cupom', 'nome', 'whatsapp', 'cpf', 'cpfHash', 'nascimento', 'pixTipo', 'pixChave', 'uid', 'status', 'criadoEmMs'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 80"
        },
        "whatsapp": {
          ".validate": "newData.isString() && newData.val().matches(/^55[0-9]{10,11}$/)"
        },
        "cpf": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{11}$/)"
        },
        "cpfHash": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
        },
        "nascimento": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "pixTipo": {
          ".validate": "newData.val() == 'cpf' || newData.val() == 'celular' || newData.val() == 'email' || newData.val() == 'aleatoria'"
        },
        "pixChave": {
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 100"
        },
        "status": {
          ".validate": "newData.val() == 'cupom_gerado' || newData.val() == 'cartao_feito' || newData.val() == 'parcela_paga' || newData.val() == 'pix_pago' || newData.val() == 'cancelado'"
        }
      }
    },
    "indique_cpfs": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      "$h": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['cupom', 'uid']) && newData.child('uid').val() == auth.uid && newData.parent().parent().child('indicacoes').child(newData.child('cupom').val()).child('cpfHash').val() == $h"
      }
    },
    "indique_cupons": {
      ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      "$cupom": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('ativo').val() == true && newData.parent().parent().child('indicacoes').child($cupom).child('uid').val() == auth.uid",
        ".validate": "newData.hasChildren(['nome', 'ativo'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "ativo": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "indique_stats": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'padroleta@gmail.com'",
      "$cupom": {
        "$campo": {
          ".write": "auth != null && root.child('indique_cupons').child($cupom).exists() && ($campo == 'visitas' || $campo == 'cliques' || $campo == 'compartilhamentos')",
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}